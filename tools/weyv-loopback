#!/usr/bin/env python3
"""
weyv-loopback — Linux karşılığı PulseLoopback.cs (WASAPI loopback).

Varsayılan çıkış cihazının monitör kaynağını (sink.monitor) mono float32
olarak okur ve Weyv'in beklediği PULSE1 sözleşmesiyle stdout'a yazar:

  stdout: "PULSE1 <sampleRate> <channels>\\n"  +  kesintisiz little-endian
          float32 MONO örnekler
  exit  : 0 normal (SIGTERM dahil)
          2 başlatılamadı (parec yok, kaynak bulunamadı)
          3 cihaz geçersizleşti (varsayılan çıkış değişti) — çağıran respawn eder

Uygulama: `parec` (PulseAudio/PipeWire-pulse) + `pactl` sorgusu.
Varsayılan çıkış 1 sn aralıkla izlenir; değişirse exit 3.
"""

import os
import signal
import subprocess
import sys
import threading
import time

RATE = 48000
CHANNELS = 1
CHUNK = 4096            # byte; mono float32 => 1024 örnek
POLL_SECONDS = 1.0

EXIT_OK = 0
EXIT_START_FAILED = 2
EXIT_DEVICE_CHANGED = 3


def default_sink():
    try:
        out = subprocess.run(
            ["pactl", "get-default-sink"],
            capture_output=True, text=True, timeout=3, check=True,
        )
        name = out.stdout.strip()
        return name or None
    except (subprocess.SubprocessError, OSError):
        return None


def fail(message, code):
    sys.stderr.write(f"[weyv-loopback] {message}\n")
    sys.stderr.flush()
    sys.exit(code)


def main():
    sink = default_sink()
    if not sink:
        fail("varsayılan çıkış cihazı okunamadı (pactl)", EXIT_START_FAILED)

    monitor = f"{sink}.monitor"
    try:
        capture = subprocess.Popen(
            ["parec", "--format=float32le", f"--channels={CHANNELS}",
             f"--rate={RATE}", "--latency-msec=20", "-d", monitor],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except OSError as error:
        fail(f"parec başlatılamadı: {error}", EXIT_START_FAILED)

    # Başlık: çağıran format bilgisini bunu okuyarak alır.
    out = sys.stdout.buffer
    out.write(f"PULSE1 {RATE} {CHANNELS}\n".encode("ascii"))
    out.flush()

    stop = threading.Event()
    changed = threading.Event()

    def watch_device():
        current = sink
        while not stop.wait(POLL_SECONDS):
            now = default_sink()
            if now and now != current:
                changed.set()
                capture.terminate()
                return

    watcher = threading.Thread(target=watch_device, daemon=True)
    watcher.start()

    def on_term(signum, frame):
        stop.set()
        capture.terminate()

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    try:
        while True:
            chunk = capture.stdout.read(CHUNK)
            if not chunk:
                break
            out.write(chunk)
            out.flush()
    except BrokenPipeError:
        # Çağıran süreç kapandı: sessizce çık.
        pass
    finally:
        stop.set()
        capture.terminate()
        try:
            capture.wait(timeout=2)
        except subprocess.TimeoutExpired:
            capture.kill()

    if changed.is_set():
        sys.exit(EXIT_DEVICE_CHANGED)
    if capture.returncode not in (0, None, -15) and not stop.is_set():
        err = capture.stderr.read().decode("utf-8", "replace").strip()
        fail(f"parec beklenmedik şekilde çıktı: {err}", EXIT_START_FAILED)
    sys.exit(EXIT_OK)


if __name__ == "__main__":
    main()
